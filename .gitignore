# The repo is public, so only the app's own files may enter it. Backups and everything else stay local.
*
!/.gitignore
!/index.html
!/app.js
!/store.js
!/config.js
!/sw.js
!/style.css
!/manifest.webmanifest
!/icon.svg
!/icon-180.png
!/icon-192.png
!/icon-512.png
!/SETUP.md
!/privacy.html
!/schema.sql
!/supabase/
/supabase/*
!/supabase/functions/
/supabase/functions/*
!/supabase/functions/ebay-sync/
/supabase/functions/ebay-sync/*
!/supabase/functions/ebay-sync/index.ts
!/supabase/functions/depop-sync/
/supabase/functions/depop-sync/*
!/supabase/functions/depop-sync/index.ts
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
